{"name": "bugsnap", "version": "0.10.0", "private": true, "description": "Visual bug capture and feedback tool for teams", "workspaces": ["apps/*", "packages/*"], "scripts": {"build": "turbo run build", "dev": "turbo run dev", "lint": "turbo run lint", "format": "prettier --write \"**/*.{ts,tsx,md,json}\"", "clean": "turbo run clean && rm -rf node_modules", "test": "turbo run test", "type-check": "turbo run type-check"}, "devDependencies": {"@types/node": "^20.11.0", "prettier": "^3.2.4", "turbo": "^1.11.3", "typescript": "^5.3.3"}, "engines": {"node": ">=18.0.0", "npm": ">=9.0.0"}, "packageManager": "npm@10.2.4"}