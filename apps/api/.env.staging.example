# BugSnap API - Staging Environment Configuration
# Copy this to .env.staging and fill in the values.

# Server Configuration
PORT=3001
NODE_ENV=staging

# Frontend URL (staging)
FRONTEND_URL=https://bugsnap-staging.vercel.app

# Database (staging — separate from production!)
DATABASE_URL="postgresql://user:password@staging-host:5432/bugsnap_staging?schema=public"

# JWT Secret (generate a unique value for staging)
JWT_SECRET=staging-secret-change-this

# CORS Allowed Origins (staging frontend)
ALLOWED_ORIGINS=https://bugsnap-staging.vercel.app

# Sentry (use separate staging project DSN)
SENTRY_DSN=

# OAuth (use separate staging OAuth apps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# API URL (staging)
API_URL=https://bugsnap-api-staging.onrender.com

# Redis (optional — staging Redis instance)
REDIS_URL=

# Cloudinary (can share with prod or use separate folder)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
