# Database Configuration
DATABASE_URL=postgresql://postgres:[password]@[host]:[port]/[database]

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS Configuration (optional, if you want to restrict origins)
# ALLOWED_ORIGINS=https://your-frontend-url.com,https://your-custom-domain.com