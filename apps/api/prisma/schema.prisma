// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN     // System administrators -> full access to all projects and settings
  MANAGER   // Project managers -> manage projects and project members
  DEVELOPER // Developers/Designers/Project Members -> invited by MANAGER, will fix reports
  VIEWER    // Clients/Guests -> PUBLIC Shareable link, viewing only
}

// Issue was previously named Task — DB enum remains "TaskType" via @@map
enum IssueType {
  BUG
  FEATURE
  TASK      // Default for backwards compatibility

  @@map("TaskType")
}

enum FeedbackType {
  BUG
  FEATURE
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String?  // Optional for OAuth-only users
  name           String
  role           UserRole @default(MANAGER)
  oauthProvider  String?  // "google" or "github"
  oauthId        String?  // Provider's user ID
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  ownedProjects       Project[]
  projectMembers      ProjectMember[]
  createdIssues       Issue[]    @relation("IssueCreator")
  assignedIssues      Issue[]    @relation("IssueAssignee")
  comments            Comment[]
  feedback            Feedback[]
  passwordResetTokens PasswordResetToken[]
  activityLogs        ActivityLog[]
  notifications       Notification[]
  createdQACycles     QACycle[]  @relation("QACycleCreator")

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

model Project {
  id            String   @id @default(uuid())
  name          String
  websiteUrl    String   // URL of the website being tracked
  apiKey        String   @unique @default(uuid())
  generalAccess String   @default("INVITED") // "INVITED" or "ANYONE"
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  issues         Issue[]
  qaCycles       QACycle[]
  activityLogs   ActivityLog[]
  notifications  Notification[]
  shareTokens    ShareToken[]

  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      UserRole @default(DEVELOPER)
  addedAt   DateTime @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // Ensure a user can only be added once per project
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// Issue was previously named Task — DB table remains "tasks" via @@map
model Issue {
  id              String    @id @default(uuid())
  projectId       String
  title           String
  description     String?   @db.Text
  url             String?
  screenshotUrl       String?
  screenshotBackupUrl String?
  rawScreenshotUrl    String?
  status          String    @default("open") // open, in_progress, resolved, closed
  type            IssueType @default(TASK)   // BUG, FEATURE, TASK
  environmentData Json?
  visibility      String    @default("members") // members, members_and_clients
  assignedToId    String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("IssueCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("IssueAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  annotations  Annotation[]
  comments      Comment[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  shareTokens   ShareToken[]
  attachments   Attachment[]
  qaCycles      QACycleIssue[]

  @@index([projectId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([type])
  @@map("tasks")
}

model Annotation {
  id          String   @id @default(uuid())
  issueId     String   @map("taskId")
  type        String // pen, highlighter, rectangle, text, arrow
  coordinates Json
  content     String?
  color       String?
  createdAt   DateTime @default(now())

  // Relations
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("annotations")
}

model Comment {
  id               String   @id @default(uuid())
  issueId          String?  @map("taskId")
  feedbackId       String?
  userId           String
  content          String   @db.Text
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations — exactly one of issue/feedback is set (enforced by DB CHECK constraint)
  issue    Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  feedback Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([feedbackId])
  @@index([userId])
  @@map("comments")
}

model Feedback {
  id          String         @id @default(uuid())
  type        FeedbackType
  title       String
  description String?        @db.Text
  status      FeedbackStatus @default(OPEN)
  priority    String?        // low, medium, high, critical
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  comments      Comment[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  shareTokens   ShareToken[]
  attachments   Attachment[]

  @@index([createdById])
  @@index([status])
  @@index([type])
  @@map("feedback")
}

model ShareToken {
  id         String    @id @default(uuid())
  token      String    @unique @default(uuid())
  issueId    String?
  projectId  String?
  feedbackId String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  issue    Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feedback Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("share_tokens")
}

model Attachment {
  id         String   @id @default(uuid())
  issueId    String?
  feedbackId String?
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  createdAt  DateTime @default(now())

  issue    Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  feedback Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([feedbackId])
  @@map("attachments")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String   // recipient
  type       String   // assigned, mentioned, status_changed, commented
  title      String
  message    String?
  issueId    String?
  projectId  String?
  feedbackId String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue    Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feedback Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid())
  issueId    String?
  feedbackId String?
  projectId  String?
  userId     String
  action     String   // created, updated, status_changed, assigned, commented, deleted
  field      String?  // which field changed (e.g., "status", "priority", "assignedToId")
  oldValue   String?
  newValue   String?
  metadata   Json?    // extra context (e.g., comment snippet)
  createdAt  DateTime @default(now())

  issue    Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  feedback Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([feedbackId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model QACycle {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?   @db.Text
  status      String    @default("open")  // open, in_progress, completed
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("QACycleCreator", fields: [createdById], references: [id])
  issues      QACycleIssue[]

  @@index([projectId])
  @@index([status])
  @@map("qa_cycles")
}

model QACycleIssue {
  id         String   @id @default(uuid())
  qaCycleId  String
  issueId    String
  addedAt    DateTime @default(now())

  qaCycle    QACycle  @relation(fields: [qaCycleId], references: [id], onDelete: Cascade)
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([qaCycleId, issueId])
  @@map("qa_cycle_issues")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}