// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER   // Project managers -> manage projects and project members
  DEVELOPER // Developers/Designers/Project Members -> invited by MANAGER, will fix reports
  VIEWER    // Clients/Guests -> PUBLIC Shareable link, viewing only
}

enum TaskType {
  BUG
  FEATURE
  TASK      // Default for backwards compatibility
}

enum FeedbackType {
  BUG
  FEATURE
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String?  // Optional for OAuth-only users
  name           String
  role           UserRole @default(MANAGER)
  oauthProvider  String?  // "google" or "github"
  oauthId        String?  // Provider's user ID
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  ownedProjects    Project[]
  projectMembers   ProjectMember[]
  createdTasks     Task[]     @relation("TaskCreator")
  assignedTasks    Task[]     @relation("TaskAssignee")
  comments         Comment[]
  feedback         Feedback[]
  feedbackComments FeedbackComment[]

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  websiteUrl  String   // URL of the website being tracked
  apiKey      String   @unique @default(uuid())
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tasks          Task[]

  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      UserRole @default(DEVELOPER)
  addedAt   DateTime @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // Ensure a user can only be added once per project
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id              String   @id @default(uuid())
  projectId       String
  title           String
  description     String?  @db.Text
  url             String?
  screenshotUrl   String?
  status          String   @default("open") // open, in_progress, resolved, closed
  priority        String?  // low, medium, high, critical (optional, no default)
  type            TaskType @default(TASK)   // BUG, FEATURE, TASK
  environmentData Json?
  visibility      String   @default("members") // members, members_and_clients
  assignedToId    String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo  User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  annotations Annotation[]
  comments    Comment[]

  @@index([projectId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@map("tasks")
}

model Annotation {
  id          String   @id @default(uuid())
  taskId      String
  type        String // pen, highlighter, rectangle, text, arrow
  coordinates Json
  content     String?
  color       String?
  createdAt   DateTime @default(now())

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("annotations")
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

model Feedback {
  id          String         @id @default(uuid())
  type        FeedbackType
  title       String
  description String?        @db.Text
  status      FeedbackStatus @default(OPEN)
  priority    String?        // low, medium, high, critical
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  comments  FeedbackComment[]

  @@index([createdById])
  @@index([status])
  @@index([type])
  @@map("feedback")
}

model FeedbackComment {
  id         String   @id @default(uuid())
  feedbackId String
  userId     String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([userId])
  @@map("feedback_comments")
}