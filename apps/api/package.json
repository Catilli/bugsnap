{
  "name": "api",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && rm -rf dist && tsc",
    "migrate": "prisma migrate deploy",
    "start": "node -e \"if(!process.env.DATABASE_URL){console.error('ERROR: DATABASE_URL environment variable is not set. Please configure it in Render dashboard.');process.exit(1)}\" && prisma migrate deploy && node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:fresh": "prisma migrate reset --force --skip-seed && npx tsx prisma/resetAndSeed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.986.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/oauth2": "^8.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^5.8.1",
    "@sentry/node": "^10.38.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.67.3",
    "cloudinary": "^2.9.0",
    "dotenv": "^16.4.1",
    "fastify": "^5.7.4",
    "ioredis": "^5.9.2",
    "resend": "^4.0.0",
    "sanitize-html": "^2.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitest/coverage-v8": "^4.0.18",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "tar": "^7.5.4"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
